{
  "case_id": "analyst-grants-file-tools",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Create a new behavior with the display name \"analyst\". Its own AgentContext has the system prompt exactly: You are Analyst, a read-only file assistant for research notes. Read and report; never modify files. Its own Tools document has files read-only granting exactly read_file and list_files, bash off, datastore off. Leave your own configuration untouched. Apply it and confirm.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "analyst_behavior",
            "max_rows": 1,
            "expect": [
              {
                "field": "behavior_id",
                "matches": ":analyst$"
              },
              {
                "field": "enabled",
                "equals": true
              },
              {
                "field": "context_id",
                "matches": ".+"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "analyst_behavior",
          "collection": "AgentBehavior",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_like": "%:analyst"
            }
          },
          "fields": [
            "behavior_id",
            "display_name",
            "context_id",
            "enabled"
          ]
        }
      ]
    },
    {
      "stage_id": "readback_context",
      "prompt": "Read back the context you created for analyst and report it. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "analyst_context",
            "max_rows": 1,
            "expect": [
              {
                "field": "system_prompt",
                "contains": "You are Analyst, a read-only file assistant for research notes."
              },
              {
                "field": "tools_id",
                "matches": ".+"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "analyst_context",
          "collection": "AgentContext",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "context_id": {
              "_like": "context-%"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Start a working session that runs behavior \"analyst\" and have it list the files under the notes directory. Change nothing else.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "analyst_sessions",
            "min_rows": 1,
            "max_rows": 1,
            "expect": [
              {
                "field": "behavior_id",
                "matches": ":analyst$"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "analyst_sessions",
          "collection": "AgentSession",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_like": "%:analyst"
            }
          },
          "fields": [
            "session_id",
            "behavior_id"
          ]
        }
      ]
    },
    {
      "stage_id": "exercise_requests",
      "prompt": "Report the requests the analyst session produced, reading them from the node's records. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "analyst_requests",
            "min_rows": 1,
            "expect": [
              {
                "field": "behavior_id",
                "matches": ":analyst$"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "analyst_requests",
          "collection": "AgentRequest",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_like": "%:analyst"
            }
          },
          "fields": [
            "request_id",
            "behavior_id",
            "session_id"
          ]
        }
      ]
    },
    {
      "stage_id": "verify_no_side_effects",
      "prompt": "Confirm with the config tool that exactly one Tools document on this node grants read_file, and that your own behavior, context, and Tools document are unchanged. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "tools_with_readfile",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 3
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "tools_all",
            "min_rows": 2,
            "max_rows": 2,
            "expect": [
              {
                "field": "tools_id",
                "matches": ".+"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "tools_with_readfile",
          "collection": "Tools",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "host": {
              "_like": "%read_file%"
            }
          },
          "fields": [
            "tools_id",
            "host"
          ]
        },
        {
          "kind": "documents",
          "name": "tools_all",
          "collection": "Tools",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host"
          ]
        }
      ]
    }
  ]
}
