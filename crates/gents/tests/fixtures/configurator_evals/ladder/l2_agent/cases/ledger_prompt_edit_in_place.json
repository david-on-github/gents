{
  "case_id": "ledger-prompt-edit-in-place",
  "split": "held_out",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Create a new behavior with the exact id \"ledger\" and display name \"Ledger\", its own AgentContext with the exact id \"ledger-context\" and system prompt exactly: You are Ledger, a read-only file assistant. Its own Tools document has the exact id \"ledger-tools\" granting exactly read_file and list_files. Do not touch your own configuration. Apply it and confirm.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "ledger_behavior",
            "max_rows": 1,
            "expect": [
              {
                "field": "behavior_id",
                "equals": "ledger"
              },
              {
                "field": "enabled",
                "equals": true
              },
              {
                "field": "context_id",
                "matches": ".+"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "ledger_behavior",
          "collection": "AgentBehavior",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_eq": "ledger"
            }
          },
          "fields": [
            "behavior_id",
            "display_name",
            "context_id",
            "enabled"
          ]
        }
      ]
    },
    {
      "stage_id": "edit_prompt_in_place",
      "prompt": "Update ledger's instructions: edit the context \"ledger-context\" in place so its system prompt ends with this added line: Always cite the file path you read. Do not clone the behavior, create a new context, or rebind anything. Report the read-back of the edited prompt.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "contexts_all",
            "min": 2,
            "max": 2
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "ledger_context",
            "max_rows": 1,
            "expect": [
              {
                "field": "system_prompt",
                "contains": "You are Ledger, a read-only file assistant."
              },
              {
                "field": "system_prompt",
                "contains": "Always cite the file path you read."
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "contexts_all",
          "collection": "AgentContext",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt"
          ]
        },
        {
          "kind": "documents",
          "name": "ledger_context",
          "collection": "AgentContext",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "context_id": {
              "_eq": "ledger-context"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Start a working session that runs behavior \"ledger\" and have it read the workspace readme and cite its path. Change nothing else.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "ledger_sessions",
            "min_rows": 1,
            "max_rows": 1,
            "expect": [
              {
                "field": "behavior_id",
                "equals": "ledger"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "ledger_sessions",
          "collection": "AgentSession",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_eq": "ledger"
            }
          },
          "fields": [
            "session_id",
            "behavior_id"
          ]
        }
      ]
    },
    {
      "stage_id": "exercise_requests",
      "prompt": "Report the requests the ledger session produced, reading them from the node's records. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "ledger_requests",
            "min_rows": 1,
            "expect": [
              {
                "field": "behavior_id",
                "equals": "ledger"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "ledger_requests",
          "collection": "AgentRequest",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_eq": "ledger"
            }
          },
          "fields": [
            "request_id",
            "behavior_id",
            "session_id"
          ]
        }
      ]
    }
  ]
}
