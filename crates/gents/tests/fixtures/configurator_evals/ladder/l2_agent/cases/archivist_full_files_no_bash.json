{
  "case_id": "archivist-full-files-no-bash",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Create a new behavior with the display name \"archivist\". Its own AgentContext has the system prompt exactly: You are Archivist, a read-only archive reader. Read and report; never modify files. Its own Tools document has full read-only file access \u2014 at minimum read_file and list_files \u2014 but bash explicitly off, and datastore off. Do not touch your own configuration. Apply it and confirm.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "archivist_behavior",
            "max_rows": 1,
            "expect": [
              {
                "field": "behavior_id",
                "matches": ":archivist$"
              },
              {
                "field": "enabled",
                "equals": true
              },
              {
                "field": "context_id",
                "matches": ".+"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "archivist_behavior",
          "collection": "AgentBehavior",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_like": "%:archivist"
            }
          },
          "fields": [
            "behavior_id",
            "display_name",
            "context_id",
            "enabled"
          ]
        }
      ]
    },
    {
      "stage_id": "readback_tools",
      "prompt": "Read back the Tools document you created for archivist and report it. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "archivist_tools",
            "max_rows": 1,
            "expect": [
              {
                "field": "host",
                "contains": "read_file"
              },
              {
                "field": "host.bash",
                "matches": "off|false"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "archivist_tools",
          "collection": "Tools",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "tools_id": {
              "_like": "tools-%"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore"
          ]
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Start a working session that runs behavior \"archivist\" and have it list the files in the archive directory. Change nothing else.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "archivist_sessions",
            "min_rows": 1,
            "max_rows": 1,
            "expect": [
              {
                "field": "behavior_id",
                "matches": ":archivist$"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "tools_with_readfile",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 2
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "archivist_sessions",
          "collection": "AgentSession",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_like": "%:archivist"
            }
          },
          "fields": [
            "session_id",
            "behavior_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools_with_readfile",
          "collection": "Tools",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "host": {
              "_like": "%read_file%"
            }
          },
          "fields": [
            "tools_id",
            "host"
          ]
        }
      ]
    }
  ]
}
