{
  "case_id": "cursor-grants-list-only",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Create a new behavior with the display name \"cursor\", its own AgentContext and system prompt exactly: You are Cursor, a directory listing assistant. Its own Tools document grants exactly list_files and nothing else \u2014 no read_file, no bash, no datastore. Do not touch your own configuration. Apply it and confirm.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "cursor_behavior",
            "max_rows": 1,
            "expect": [
              {
                "field": "behavior_id",
                "matches": ":cursor$"
              },
              {
                "field": "enabled",
                "equals": true
              },
              {
                "field": "context_id",
                "matches": ".+"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "cursor_behavior",
          "collection": "AgentBehavior",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_like": "%:cursor"
            }
          },
          "fields": [
            "behavior_id",
            "display_name",
            "context_id",
            "enabled"
          ]
        }
      ]
    },
    {
      "stage_id": "verify_absence_of_readfile",
      "prompt": "Read back cursor's configuration with the config tool and confirm list_files is granted, no Tools document on this node grants read_file, and your own configuration is unchanged. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "tools_with_readfile",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 3
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "cursor_tools",
            "max_rows": 1,
            "expect": [
              {
                "field": "host.files.mode",
                "matches": "ReadOnly|ReadWrite"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "tools_with_readfile",
          "collection": "Tools",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "tools_id": {
              "_like": "tools-%"
            }
          },
          "fields": [
            "tools_id",
            "host"
          ]
        },
        {
          "kind": "documents",
          "name": "cursor_tools",
          "collection": "Tools",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "tools_id": {
              "_like": "tools-%"
            }
          },
          "fields": [
            "tools_id",
            "host"
          ]
        }
      ]
    },
    {
      "stage_id": "verify_no_side_effects",
      "prompt": "Confirm the node holds exactly two Tools documents and two behaviors \u2014 yours and cursor's \u2014 and that your own behavior, context, and Tools document are unchanged. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "tools_all",
            "min": 2,
            "max": 2
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "contexts_all",
            "min_rows": 2,
            "max_rows": 2,
            "expect": [
              {
                "field": "context_id",
                "matches": ".+"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "tools_all",
          "collection": "Tools",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts_all",
          "collection": "AgentContext",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt"
          ]
        }
      ]
    }
  ]
}
