{
  "case_id": "clerk-automation-seed-fire",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type RestockNote { sku: String }"
    ],
    "documents": []
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Create a new behavior with the exact id \"clerk\" and display name \"Clerk\", its own AgentContext with the exact id \"clerk-context\" and system prompt exactly: You are Clerk, a restock note clerk. Acknowledge each restock note by sku. Its own Tools document has the exact id \"clerk-tools\" granting exactly read_file and list_files. Then configure an automation on top of it: an EventSource with the exact id \"clerk-source\" watching collection RestockNote, wired through a Trigger with the exact id \"clerk-trigger\" to a Task with the exact id \"clerk-task\" that selects behavior \"clerk\" and renders the source document's sku into its request. Do not touch your own configuration. Apply it and confirm.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "clerk_behavior",
            "max_rows": 1,
            "expect": [
              {
                "field": "behavior_id",
                "equals": "clerk"
              },
              {
                "field": "enabled",
                "equals": true
              },
              {
                "field": "context_id",
                "matches": ".+"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "clerk_behavior",
          "collection": "AgentBehavior",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_eq": "clerk"
            }
          },
          "fields": [
            "behavior_id",
            "display_name",
            "context_id",
            "enabled"
          ]
        }
      ]
    },
    {
      "stage_id": "readback_trigger",
      "prompt": "Read back the trigger you created for the clerk automation and report it. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "clerk_trigger",
            "max_rows": 1,
            "expect": [
              {
                "field": "trigger_id",
                "equals": "clerk-trigger"
              },
              {
                "field": "task_id",
                "matches": ".+"
              },
              {
                "field": "enabled",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "clerk_trigger",
          "collection": "Trigger",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "trigger_id": {
              "_eq": "clerk-trigger"
            }
          },
          "fields": [
            "trigger_id",
            "task_id",
            "enabled"
          ]
        }
      ]
    },
    {
      "stage_id": "seed_restock_note",
      "seed": {
        "collection": "RestockNote",
        "document": {
          "sku": "A-100"
        }
      },
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "clerk_fires",
            "min_rows": 1,
            "expect": [
              {
                "field": "source_collection",
                "equals": "RestockNote"
              },
              {
                "field": "trigger_id",
                "equals": "clerk-trigger"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "clerk_fires",
          "collection": "TriggerFire",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "trigger_id": {
              "_eq": "clerk-trigger"
            },
            "source_collection": {
              "_eq": "RestockNote"
            }
          },
          "fields": [
            "fire_key",
            "trigger_id",
            "source_collection",
            "request_id"
          ]
        }
      ]
    },
    {
      "stage_id": "readback_fired_request",
      "prompt": "Report the request the clerk automation produced for the restock note that was just submitted, reading it from the node's records. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "clerk_requests",
            "min_rows": 1,
            "expect": [
              {
                "field": "behavior_id",
                "equals": "clerk"
              },
              {
                "field": "caused_by_source_doc_id",
                "matches": ".+"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 3
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "clerk_requests",
          "collection": "AgentRequest",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_eq": "clerk"
            }
          },
          "fields": [
            "request_id",
            "behavior_id",
            "caused_by_trigger_id",
            "caused_by_source_doc_id"
          ]
        }
      ]
    },
    {
      "stage_id": "verify_outcome",
      "prompt": "Report what the clerk automation did with the restock note that was just submitted, reading the trigger fire, its request, and its outcome. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "clerk_outcomes",
            "min_rows": 1,
            "expect": [
              {
                "field": "trigger_id",
                "equals": "clerk-trigger"
              },
              {
                "field": "terminal_state",
                "matches": ".+"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "clerk_outcomes",
          "collection": "FireOutcome",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "trigger_id": {
              "_eq": "clerk-trigger"
            }
          },
          "fields": [
            "fire_key",
            "trigger_id",
            "terminal_state",
            "reason"
          ]
        }
      ]
    }
  ]
}
