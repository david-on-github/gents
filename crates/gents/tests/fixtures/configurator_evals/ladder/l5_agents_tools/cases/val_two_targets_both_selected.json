{
  "case_id": "val-two-targets-both-selected",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure-two",
      "prompt": "Set up two subagents. Create helper behaviors named 'beh-alpha-01' and 'beh-beta-01', both minimal. Create SubagentTarget 'tgt-alpha-01' (name 'alpha-target') pointing at 'beh-alpha-01' and SubagentTarget 'tgt-beta-01' (name 'beta-target') pointing at 'beh-beta-01', both with target_agent_did set to this node's own DID. Select both targets in your own Tools.subagents.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "all-targets",
            "min": 2,
            "max": 2
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "alpha-target",
            "expect": [
              {
                "field": "name",
                "equals": "alpha-target"
              },
              {
                "field": "behavior_id",
                "matches": ":beh\\-alpha\\-01$"
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "all-targets",
          "collection": "SubagentTarget",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "target_id",
            "name",
            "behavior_id"
          ]
        },
        {
          "kind": "documents",
          "name": "alpha-target",
          "collection": "SubagentTarget",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "target_id": {
              "_eq": "tgt-alpha-01"
            },
            "target_agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "target_id",
            "agent_did",
            "target_agent_did",
            "behavior_id",
            "name"
          ]
        }
      ]
    },
    {
      "stage_id": "verify-both-selected",
      "prompt": "Report what you configured; change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "tools-row",
            "expect": [
              {
                "field": "subagents",
                "contains": "tgt-alpha-01"
              },
              {
                "field": "subagents",
                "contains": "tgt-beta-01"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "tools-row",
          "collection": "Tools",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "tools_id": {
              "_eq": "engineer-tools"
            }
          },
          "fields": [
            "tools_id",
            "display_name",
            "subagents"
          ]
        }
      ]
    },
    {
      "stage_id": "delegate-to-beta",
      "prompt": "Delegate a task to subagent 'beta-target' specifically: have beh-beta-01 reply with exactly BETA-777 and nothing else. End your turn after dispatch; report the reply when it arrives.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "agent_new"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "beta-session",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "beta-request",
            "expect": [
              {
                "field": "content",
                "contains": "BETA-777"
              },
              {
                "field": "lifecycle_state",
                "equals": "completed"
              },
              {
                "field": "terminal_output",
                "contains": "message_doc_id"
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "beta-request",
                "key": "behavior_id",
                "id": "beh-beta-01",
                "field": "caused_by_parent_tool_call_doc_id",
                "target_capture": "delegation_calls",
                "target_key": "_docID",
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "completion_notification_delivered_at",
                    "matches": "^[0-9]{4}-"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "BETA-777"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "beta-session",
          "collection": "AgentSession",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_like": "%:beh-beta-01"
            }
          },
          "fields": [
            "session_id",
            "behavior_id",
            "agent_did"
          ]
        },
        {
          "kind": "documents",
          "name": "beta-request",
          "collection": "AgentRequest",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_like": "%:beh-beta-01"
            }
          },
          "fields": [
            "request_id",
            "behavior_id",
            "session_id",
            "content",
            "lifecycle_state",
            "terminal_output",
            "caused_by_parent_tool_call_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "delegation_calls",
          "collection": "AgentToolCall",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_in": [
                "agent_new",
                "agent_message"
              ]
            }
          },
          "fields": [
            "_docID",
            "lifecycle_state",
            "completion_notification_delivered_at"
          ]
        }
      ],
      "settle": true
    }
  ]
}
