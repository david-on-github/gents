{
  "case_id": "train-minimal-self-target",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Set up subagent delegation on this node. Create a helper behavior with the display name 'beh-helper-01' (a minimal behavior is fine). Then create a SubagentTarget with id 'tgt-train-01', name 'train-target', target_agent_did set to this node's own DID, and behavior 'beh-helper-01'. Select 'tgt-train-01' in your own Tools.subagents.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "train-target",
            "expect": [
              {
                "field": "name",
                "equals": "train-target"
              },
              {
                "field": "behavior_id",
                "matches": ":beh\\-helper\\-01$"
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 2
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "train-target",
          "collection": "SubagentTarget",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "target_id": {
              "_eq": "tgt-train-01"
            },
            "target_agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "target_id",
            "agent_did",
            "target_agent_did",
            "behavior_id",
            "name"
          ]
        }
      ]
    },
    {
      "stage_id": "verify-selection",
      "prompt": "Report what you configured; change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "tools-row",
            "expect": [
              {
                "field": "subagents",
                "contains": "tgt-train-01"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "helper-behavior",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 2
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "tools-row",
          "collection": "Tools",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "tools_id": {
              "_eq": "engineer-tools"
            }
          },
          "fields": [
            "tools_id",
            "display_name",
            "subagents"
          ]
        },
        {
          "kind": "documents",
          "name": "helper-behavior",
          "collection": "AgentBehavior",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_like": "%:beh-helper-01"
            }
          },
          "fields": [
            "behavior_id",
            "display_name",
            "enabled"
          ]
        }
      ]
    },
    {
      "stage_id": "delegate",
      "prompt": "Delegate a task to subagent 'train-target': have the helper reply with exactly TRAIN-111 and nothing else. End your turn after dispatch; report the reply when it arrives.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "agent_new"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "helper-session",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "helper-request",
            "expect": [
              {
                "field": "content",
                "contains": "TRAIN-111"
              },
              {
                "field": "lifecycle_state",
                "equals": "completed"
              },
              {
                "field": "terminal_output",
                "contains": "message_doc_id"
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "helper-request",
                "key": "behavior_id",
                "id": "beh-helper-01",
                "field": "caused_by_parent_tool_call_doc_id",
                "target_capture": "delegation_calls",
                "target_key": "_docID",
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "completion_notification_delivered_at",
                    "matches": "^[0-9]{4}-"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "TRAIN-111"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "helper-session",
          "collection": "AgentSession",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_like": "%:beh-helper-01"
            }
          },
          "fields": [
            "session_id",
            "behavior_id",
            "agent_did"
          ]
        },
        {
          "kind": "documents",
          "name": "helper-request",
          "collection": "AgentRequest",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_like": "%:beh-helper-01"
            }
          },
          "fields": [
            "request_id",
            "behavior_id",
            "session_id",
            "content",
            "lifecycle_state",
            "terminal_output",
            "caused_by_parent_tool_call_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "delegation_calls",
          "collection": "AgentToolCall",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_in": [
                "agent_new",
                "agent_message"
              ]
            }
          },
          "fields": [
            "_docID",
            "lifecycle_state",
            "completion_notification_delivered_at"
          ]
        }
      ],
      "settle": true
    },
    {
      "stage_id": "follow_up",
      "prompt": "Send a follow-up to the same helper session: reply with exactly FOLLOW-222 and nothing else. Reuse that session; do not start another. End your turn after dispatch; report the reply when it arrives.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "agent_message"
            ],
            "forbidden": [
              "agent_new"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "helper-session",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "helper-request",
            "expect": [
              {
                "field": "content",
                "contains": "FOLLOW-222"
              },
              {
                "field": "lifecycle_state",
                "equals": "completed"
              },
              {
                "field": "terminal_output",
                "contains": "message_doc_id"
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "helper-request",
                "key": "behavior_id",
                "id": "beh-helper-01",
                "field": "caused_by_parent_tool_call_doc_id",
                "target_capture": "delegation_calls",
                "target_key": "_docID",
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "completion_notification_delivered_at",
                    "matches": "^[0-9]{4}-"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "FOLLOW-222"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "helper-session",
          "collection": "AgentSession",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_like": "%:beh-helper-01"
            }
          },
          "fields": [
            "session_id",
            "behavior_id",
            "agent_did"
          ]
        },
        {
          "kind": "documents",
          "name": "helper-request",
          "collection": "AgentRequest",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_like": "%:beh-helper-01"
            },
            "content": {
              "_like": "%FOLLOW-222%"
            }
          },
          "fields": [
            "request_id",
            "behavior_id",
            "session_id",
            "content",
            "lifecycle_state",
            "terminal_output",
            "caused_by_parent_tool_call_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "delegation_calls",
          "collection": "AgentToolCall",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_in": [
                "agent_new",
                "agent_message"
              ]
            }
          },
          "fields": [
            "_docID",
            "lifecycle_state",
            "completion_notification_delivered_at"
          ]
        }
      ],
      "settle": true
    }
  ]
}
