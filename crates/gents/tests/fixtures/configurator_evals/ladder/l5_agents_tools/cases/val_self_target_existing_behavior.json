{
  "case_id": "val-self-target-existing-behavior",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Make it possible for you to delegate to a new conversation running your same role and settings. Call it helper; reuse your existing role.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "targets",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "behaviors": "behaviors",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "behavior_id": "engineer",
                  "delegates": {
                    "targets": "targets",
                    "behaviors": [
                      "engineer"
                    ]
                  }
                }
              ]
            }
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "behaviors",
          "collection": "AgentBehavior",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "behavior_id",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "tools_id",
            "system_prompt"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "subagents",
            "self_config"
          ]
        },
        {
          "kind": "documents",
          "name": "targets",
          "collection": "SubagentTarget",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "target_id",
            "agent_did",
            "name",
            "target_agent_did",
            "behavior_id"
          ]
        }
      ]
    },
    {
      "stage_id": "delegate",
      "prompt": "Ask helper to reply with exactly ECHO-2468 and report its reply when it arrives.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "agent_new"
            ],
            "forbidden": [
              "bash",
              "config"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "trial-sessions",
            "min": 2
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "helper-request",
            "max_rows": 1,
            "expect": [
              {
                "field": "lifecycle_state",
                "equals": "completed"
              },
              {
                "field": "terminal_output",
                "contains": "message_doc_id"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 3
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "helper-request",
                "key": "behavior_id",
                "id": "engineer",
                "field": "caused_by_parent_tool_call_doc_id",
                "target_capture": "delegation_calls",
                "target_key": "_docID",
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "completion_notification_delivered_at",
                    "matches": "^[0-9]{4}-"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "ECHO-2468"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "trial-sessions",
          "collection": "AgentSession",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "session_id",
            "behavior_id",
            "agent_did"
          ]
        },
        {
          "kind": "documents",
          "name": "helper-request",
          "collection": "AgentRequest",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "content": {
              "_like": "%ECHO-2468%"
            },
            "subagent_depth": {
              "_gt": 0
            },
            "purpose": {
              "_eq": "normal"
            }
          },
          "fields": [
            "content",
            "lifecycle_state",
            "terminal_output",
            "behavior_id",
            "caused_by_parent_tool_call_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "delegation_calls",
          "collection": "AgentToolCall",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_in": [
                "agent_new",
                "agent_message"
              ]
            }
          },
          "fields": [
            "_docID",
            "lifecycle_state",
            "completion_notification_delivered_at"
          ]
        }
      ],
      "settle": true
    }
  ]
}
