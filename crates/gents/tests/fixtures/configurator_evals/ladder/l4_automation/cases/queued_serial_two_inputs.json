{
  "case_id": "queued-serial-two-inputs",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type QueueNote { message: String handoff_id: String }"
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "On this node, set up document automation for me. A schema for a collection QueueNote (string field 'message') is already published. Configure the following with the config tool, never bash: an EventSource with display_name 'QueueNoteWatcher' watching source_collection 'QueueNote' with event_kind 'created'; a Task with display_name 'QueueNoteTask' targeting the engineer behavior with prompt_template 'Process the queued note: {{ doc.message }}' and emit_outcome true; and a Trigger with display_name 'QueueNoteTrigger' linking that EventSource to that Task with concurrency 'queued_serial'. Enable the Task and Trigger. Do not write any document into QueueNote.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "trigger_config",
            "expect": [
              {
                "field": "task_id",
                "matches": ".+"
              },
              {
                "field": "source",
                "matches": ".+"
              },
              {
                "field": "concurrency",
                "equals": "queued_serial"
              },
              {
                "field": "enabled",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "eventsource_config",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "trigger_config",
          "collection": "Trigger",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "display_name": {
              "_eq": "QueueNoteTrigger"
            }
          },
          "fields": [
            "trigger_id",
            "task_id",
            "source",
            "concurrency",
            "session_id_template",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "eventsource_config",
          "collection": "EventSource",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "display_name": {
              "_eq": "QueueNoteWatcher"
            }
          },
          "fields": [
            "event_source_id",
            "source_collection",
            "event_kind"
          ]
        }
      ]
    },
    {
      "stage_id": "task_config_readonly",
      "prompt": "Report what you configured for the QueueNote automation; change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "task_config",
            "expect": [
              {
                "field": "task_id",
                "matches": ".+"
              },
              {
                "field": "prompt_template",
                "contains": "doc.message"
              },
              {
                "field": "emit_outcome",
                "equals": true
              },
              {
                "field": "enabled",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "task_config",
          "collection": "Task",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "display_name": {
              "_eq": "QueueNoteTask"
            }
          },
          "fields": [
            "task_id",
            "prompt_template",
            "emit_outcome",
            "enabled"
          ]
        }
      ]
    },
    {
      "stage_id": "seed_first",
      "seed": {
        "collection": "QueueNote",
        "document": {
          "message": "queue-echo-31",
          "handoff_id": "queued-serial-two-inputs-1"
        }
      },
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "fires_first",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "fires_first",
          "collection": "TriggerFire",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "QueueNote"
            }
          },
          "fields": [
            "fire_key",
            "trigger_id",
            "task_id",
            "request_id",
            "session_id",
            "source_doc_id"
          ]
        }
      ]
    },
    {
      "stage_id": "seed_second",
      "seed": {
        "collection": "QueueNote",
        "document": {
          "message": "queue-echo-32",
          "handoff_id": "queued-serial-two-inputs-2"
        }
      },
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "fire_outcomes",
            "expect": [
              {
                "field": "fire_key",
                "matches": ".+"
              },
              {
                "field": "request_id",
                "matches": ".+"
              },
              {
                "field": "session_id",
                "matches": ".+"
              },
              {
                "field": "terminal_state",
                "matches": ".+"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "fire_outcomes",
          "collection": "FireOutcome",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "QueueNote"
            }
          },
          "fields": [
            "fire_key",
            "request_id",
            "session_id",
            "terminal_state",
            "source_doc_id"
          ]
        }
      ]
    },
    {
      "stage_id": "verify_readonly",
      "prompt": "Report the configured automation and its expected routing. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "fires_total",
            "min": 2,
            "max": 2
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "completed_requests",
            "expect": [
              {
                "field": "request_id",
                "matches": ".+"
              },
              {
                "field": "caused_by_trigger_id",
                "matches": ".+"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "fires_total",
          "collection": "TriggerFire",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "QueueNote"
            }
          },
          "fields": [
            "fire_key",
            "trigger_id",
            "task_id",
            "request_id",
            "source_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "completed_requests",
          "collection": "AgentRequest",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "caused_by_trigger_id",
            "caused_by_source_doc_id",
            "lifecycle_state"
          ]
        }
      ]
    }
  ]
}
