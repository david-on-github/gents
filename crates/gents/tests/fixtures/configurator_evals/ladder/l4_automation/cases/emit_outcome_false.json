{
  "case_id": "emit-outcome-false",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type QuietNote { message: String }"
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "On this node, set up document automation for me. A schema for a collection QuietNote (string field 'message') is already published. Configure the following with the config tool, never bash: an EventSource with display_name 'QuietNoteWatcher' watching source_collection 'QuietNote' with event_kind 'created'; a Task with display_name 'QuietNoteTask' targeting the engineer behavior with prompt_template 'Handle the quiet note: {{ doc.message }}' and emit_outcome false; and a Trigger with display_name 'QuietNoteTrigger' linking that EventSource to that Task with concurrency 'parallel'. Enable all three. Do not write any document into QuietNote.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "trigger_config",
            "expect": [
              {
                "field": "task_id",
                "matches": ".+"
              },
              {
                "field": "source",
                "matches": ".+"
              },
              {
                "field": "concurrency",
                "equals": "parallel"
              },
              {
                "field": "enabled",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "eventsource_config",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "trigger_config",
          "collection": "Trigger",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "display_name": {
              "_eq": "QuietNoteTrigger"
            }
          },
          "fields": [
            "trigger_id",
            "task_id",
            "source",
            "concurrency",
            "session_id_template",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "eventsource_config",
          "collection": "EventSource",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "display_name": {
              "_eq": "QuietNoteWatcher"
            }
          },
          "fields": [
            "event_source_id",
            "source_collection",
            "event_kind"
          ]
        }
      ]
    },
    {
      "stage_id": "task_config_readonly",
      "prompt": "Report what you configured for the QuietNote automation; change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "task_config",
            "expect": [
              {
                "field": "task_id",
                "matches": ".+"
              },
              {
                "field": "prompt_template",
                "contains": "doc.message"
              },
              {
                "field": "emit_outcome",
                "equals": false
              },
              {
                "field": "enabled",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "task_config",
          "collection": "Task",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "display_name": {
              "_eq": "QuietNoteTask"
            }
          },
          "fields": [
            "task_id",
            "prompt_template",
            "emit_outcome",
            "enabled"
          ]
        }
      ]
    },
    {
      "stage_id": "seed_run",
      "seed": {
        "collection": "QuietNote",
        "document": {
          "message": "quiet-echo-43"
        }
      },
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "fires",
            "expect": [
              {
                "field": "trigger_id",
                "matches": ".+"
              },
              {
                "field": "task_id",
                "matches": ".+"
              },
              {
                "field": "request_id",
                "matches": ".+"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "fire_outcomes",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "fires",
          "collection": "TriggerFire",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "QuietNote"
            }
          },
          "fields": [
            "fire_key",
            "trigger_id",
            "task_id",
            "request_id",
            "session_id",
            "source_doc_id",
            "emit_outcome"
          ]
        },
        {
          "kind": "documents",
          "name": "fire_outcomes",
          "collection": "FireOutcome",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "QuietNote"
            }
          },
          "fields": [
            "fire_key",
            "request_id",
            "session_id",
            "terminal_state"
          ]
        }
      ]
    },
    {
      "stage_id": "verify_readonly",
      "prompt": "Read the AgentRequest records caused by the QuietNote trigger and report how many reached lifecycle_state completed; change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "completed_requests",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "completed_requests",
          "collection": "AgentRequest",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "caused_by_trigger_id",
            "caused_by_source_doc_id",
            "lifecycle_state"
          ]
        }
      ]
    }
  ]
}
