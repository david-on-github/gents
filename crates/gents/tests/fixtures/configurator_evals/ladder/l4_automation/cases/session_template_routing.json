{
  "case_id": "session-template-routing",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type LeadNote { message: String }"
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "On this node, set up document automation for me. A schema for a collection LeadNote (string field 'message') is already published. First, read the AgentSession collection for your agent and find the session id of the session you are working in right now (the open session for your agent_did with the latest created_at). Then configure the following with the config tool, never bash: an EventSource with display_name 'LeadNoteWatcher' watching source_collection 'LeadNote' with event_kind 'created'; a Task with display_name 'LeadNoteTask' targeting the engineer behavior with prompt_template 'Handle the lead note: {{ doc.message }}' and emit_outcome true; and a Trigger with display_name 'LeadNoteTrigger' linking that EventSource to that Task with concurrency 'parallel' and session_id_template set to that exact session id as a literal string (not a template expression). Enable all three. Do not write any document into LeadNote.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "trigger_config",
            "expect": [
              {
                "field": "task_id",
                "matches": ".+"
              },
              {
                "field": "source",
                "matches": ".+"
              },
              {
                "field": "concurrency",
                "equals": "parallel"
              },
              {
                "field": "session_id_template",
                "matches": ".+"
              },
              {
                "field": "enabled",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "eventsource_config",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "trigger_config",
          "collection": "Trigger",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "display_name": {
              "_eq": "LeadNoteTrigger"
            }
          },
          "fields": [
            "trigger_id",
            "task_id",
            "source",
            "concurrency",
            "session_id_template",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "eventsource_config",
          "collection": "EventSource",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "display_name": {
              "_eq": "LeadNoteWatcher"
            }
          },
          "fields": [
            "event_source_id",
            "source_collection",
            "event_kind"
          ]
        }
      ]
    },
    {
      "stage_id": "task_config_readonly",
      "prompt": "Report what you configured for the LeadNote automation, including the Trigger's session_id_template value; change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "task_config",
            "expect": [
              {
                "field": "task_id",
                "matches": ".+"
              },
              {
                "field": "prompt_template",
                "contains": "doc.message"
              },
              {
                "field": "emit_outcome",
                "equals": true
              },
              {
                "field": "enabled",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "task_config",
          "collection": "Task",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "display_name": {
              "_eq": "LeadNoteTask"
            }
          },
          "fields": [
            "task_id",
            "prompt_template",
            "emit_outcome",
            "enabled"
          ]
        }
      ]
    },
    {
      "stage_id": "seed_run",
      "seed": {
        "collection": "LeadNote",
        "document": {
          "message": "lead-echo-29"
        }
      },
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "fires",
            "expect": [
              {
                "field": "trigger_id",
                "matches": ".+"
              },
              {
                "field": "request_id",
                "matches": ".+"
              },
              {
                "field": "session_id",
                "matches": ".+"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "completed_requests",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "fires",
          "collection": "TriggerFire",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "LeadNote"
            }
          },
          "fields": [
            "fire_key",
            "trigger_id",
            "task_id",
            "request_id",
            "session_id",
            "source_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "completed_requests",
          "collection": "AgentRequest",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "caused_by_trigger_id",
            "caused_by_source_doc_id",
            "lifecycle_state"
          ]
        }
      ]
    },
    {
      "stage_id": "outcome_readonly",
      "prompt": "Read the FireOutcome records for the LeadNote automation and report their session ids and states; change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "fire_outcomes",
            "expect": [
              {
                "field": "fire_key",
                "matches": ".+"
              },
              {
                "field": "request_id",
                "matches": ".+"
              },
              {
                "field": "session_id",
                "matches": ".+"
              },
              {
                "field": "terminal_state",
                "matches": ".+"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "fire_outcomes",
          "collection": "FireOutcome",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "LeadNote"
            }
          },
          "fields": [
            "fire_key",
            "request_id",
            "session_id",
            "terminal_state",
            "source_doc_id"
          ]
        }
      ]
    }
  ]
}
