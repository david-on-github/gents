{
  "case_id": "session-template-routing",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type LeadNote { message: String handoff_id: String reply_session_id: String }"
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "On this node, set up document automation for me. A schema for a collection LeadNote (string fields 'message', 'handoff_id', and 'reply_session_id') is already published. Configure the following with the config tool, never bash: an EventSource with display_name 'LeadNoteWatcher' watching source_collection 'LeadNote' with event_kind 'created'; a Task with display_name 'LeadNoteTask' targeting the engineer behavior with prompt_template 'Handle the lead note: {{ doc.message }}' and emit_outcome true; and a Trigger with display_name 'LeadNoteTrigger' linking that EventSource to that Task with concurrency 'parallel' and session_id_template '{{ doc.reply_session_id }}'. Each caller supplies the existing session ID in reply_session_id; route the request into that session. Enable the Task and Trigger. Do not write any document into LeadNote. Configure this routing only; I will send notes after setup.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "trigger_config",
            "expect": [
              {
                "field": "task_id",
                "matches": ".+"
              },
              {
                "field": "source",
                "matches": ".+"
              },
              {
                "field": "concurrency",
                "equals": "parallel"
              },
              {
                "field": "session_id_template",
                "equals": "{{ doc.reply_session_id }}"
              },
              {
                "field": "enabled",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "eventsource_config",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "trigger_config",
          "collection": "Trigger",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "display_name": {
              "_eq": "LeadNoteTrigger"
            }
          },
          "fields": [
            "trigger_id",
            "task_id",
            "source",
            "concurrency",
            "session_id_template",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "eventsource_config",
          "collection": "EventSource",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "display_name": {
              "_eq": "LeadNoteWatcher"
            }
          },
          "fields": [
            "event_source_id",
            "source_collection",
            "event_kind"
          ]
        }
      ]
    },
    {
      "stage_id": "task_config_readonly",
      "prompt": "Report what you configured for the LeadNote automation, including the Trigger's session_id_template value; change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "task_config",
            "expect": [
              {
                "field": "task_id",
                "matches": ".+"
              },
              {
                "field": "prompt_template",
                "contains": "doc.message"
              },
              {
                "field": "emit_outcome",
                "equals": true
              },
              {
                "field": "enabled",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "task_config",
          "collection": "Task",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "display_name": {
              "_eq": "LeadNoteTask"
            }
          },
          "fields": [
            "task_id",
            "prompt_template",
            "emit_outcome",
            "enabled"
          ]
        }
      ]
    }
  ]
}
