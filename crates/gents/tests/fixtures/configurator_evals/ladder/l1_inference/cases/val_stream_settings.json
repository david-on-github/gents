{
  "case_id": "val-stream-settings",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Set up streaming-tuned inference for me: create an execution exec-stream with max_turns 15, max_total_tokens 80000, stream_batch_ms 250, stream_liveness_timeout_secs 45, provider_idle_timeout_secs 120, and deadline_duration_secs 480. Then create a profile profile-stream on my existing backend pointing at exec-stream, and bind engineer to profile-stream.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "profile_bound",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "exec_limits",
            "expect": [
              {
                "field": "max_turns",
                "equals": 15
              },
              {
                "field": "max_total_tokens",
                "equals": 80000
              },
              {
                "field": "stream_batch_ms",
                "equals": 250
              },
              {
                "field": "stream_liveness_timeout_secs",
                "equals": 45
              },
              {
                "field": "provider_idle_timeout_secs",
                "equals": 120
              },
              {
                "field": "deadline_duration_secs",
                "equals": 480
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "profile_bound",
          "collection": "InferenceProfile",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "profile_id": {
              "_eq": "profile-stream"
            },
            "execution_id": {
              "_eq": "exec-stream"
            }
          },
          "fields": [
            "profile_id",
            "execution_id",
            "backend_id"
          ]
        },
        {
          "kind": "documents",
          "name": "exec_limits",
          "collection": "InferenceExecution",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "execution_id": {
              "_eq": "exec-stream"
            }
          },
          "fields": [
            "execution_id",
            "max_turns",
            "max_total_tokens",
            "stream_batch_ms",
            "stream_liveness_timeout_secs",
            "provider_idle_timeout_secs",
            "deadline_duration_secs"
          ]
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Report what you configured; change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "limited_requests",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "behavior_bound",
            "expect": [
              {
                "field": "inference_profile_id",
                "equals": "profile-stream"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "limited_requests",
          "collection": "AgentRequest",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_eq": "engineer"
            },
            "max_total_tokens": {
              "_eq": 80000
            }
          },
          "fields": [
            "request_id",
            "behavior_id",
            "max_total_tokens"
          ]
        },
        {
          "kind": "documents",
          "name": "behavior_bound",
          "collection": "AgentBehavior",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_eq": "engineer"
            }
          },
          "fields": [
            "behavior_id",
            "inference_profile_id"
          ]
        }
      ]
    }
  ]
}
