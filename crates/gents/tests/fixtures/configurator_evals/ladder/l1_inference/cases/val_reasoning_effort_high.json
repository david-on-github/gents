{
  "case_id": "val-reasoning-effort-high",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "discover",
      "prompt": "I want more careful answers on difficult problems. Check which model we are using and whether it supports a higher thinking effort. Explain the tradeoff and our current limits before changing anything.",
      "deadline_secs": 600,
      "capture": [
        {
          "kind": "documents",
          "name": "behaviors",
          "collection": "AgentBehavior",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "behavior_id",
            "display_name",
            "context_id",
            "inference_profile_id"
          ]
        },
        {
          "kind": "documents",
          "name": "profiles",
          "collection": "InferenceProfile",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "profile_id",
            "display_name",
            "backend_id",
            "execution_id",
            "model_name",
            "reasoning_effort"
          ]
        },
        {
          "kind": "documents",
          "name": "executions",
          "collection": "InferenceExecution",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "execution_id",
            "max_turns",
            "max_total_tokens",
            "deadline_duration_secs",
            "stream_batch_ms",
            "stream_liveness_timeout_secs",
            "provider_idle_timeout_secs"
          ]
        },
        {
          "kind": "documents",
          "name": "backends",
          "collection": "InferenceBackend",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "backend_id",
            "endpoint",
            "enabled"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ],
            "allowed_argv": {
              "config": [
                [
                  "help"
                ],
                [
                  "get"
                ],
                [
                  "behavior",
                  "get"
                ],
                [
                  "behavior",
                  "list"
                ],
                [
                  "profile",
                  "get"
                ],
                [
                  "profile",
                  "list"
                ],
                [
                  "execution",
                  "get"
                ],
                [
                  "execution",
                  "list"
                ],
                [
                  "backend",
                  "get"
                ],
                [
                  "backend",
                  "list"
                ],
                [
                  "tools",
                  "get"
                ],
                [
                  "tools",
                  "list"
                ],
                [
                  "--help"
                ],
                [
                  "behavior",
                  "--help"
                ],
                [
                  "tools",
                  "--help"
                ],
                [
                  "datastore",
                  "--help"
                ],
                [
                  "subagent-target",
                  "--help"
                ],
                [
                  "skill",
                  "--help"
                ],
                [
                  "discovery",
                  "--help"
                ],
                [
                  "profile",
                  "--help"
                ],
                [
                  "execution",
                  "--help"
                ],
                [
                  "backend",
                  "--help"
                ],
                [
                  "mcp-service",
                  "--help"
                ],
                [
                  "automation",
                  "--help"
                ],
                [
                  "schema",
                  "--help"
                ],
                [
                  "cleanup",
                  "--help"
                ],
                [
                  "pack",
                  "--help"
                ],
                [
                  "plan",
                  "--help"
                ]
              ]
            }
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "behaviors",
                "key": "behavior_id",
                "id": "engineer",
                "field": "inference_profile_id",
                "target_capture": "profiles",
                "target_key": "profile_id",
                "expect": [],
                "reported_fields": [
                  "model_name"
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)(limit|budget|allowance)"
              },
              {
                "matches": "(?i)(suggest|recommend|could|would|propos|can)"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "configure",
      "prompt": "Yes, use high thinking effort with the current model. Allow 40 turns and 300,000 total tokens per request. Keep the existing connection and leave the other settings alone.",
      "deadline_secs": 600,
      "capture": [
        {
          "kind": "documents",
          "name": "behaviors",
          "collection": "AgentBehavior",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "behavior_id",
            "display_name",
            "context_id",
            "inference_profile_id"
          ]
        },
        {
          "kind": "documents",
          "name": "profiles",
          "collection": "InferenceProfile",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "profile_id",
            "display_name",
            "backend_id",
            "execution_id",
            "model_name",
            "reasoning_effort"
          ]
        },
        {
          "kind": "documents",
          "name": "executions",
          "collection": "InferenceExecution",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "execution_id",
            "max_turns",
            "max_total_tokens",
            "deadline_duration_secs",
            "stream_batch_ms",
            "stream_liveness_timeout_secs",
            "provider_idle_timeout_secs"
          ]
        },
        {
          "kind": "documents",
          "name": "backends",
          "collection": "InferenceBackend",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "backend_id",
            "endpoint",
            "enabled"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "behaviors",
                "key": "behavior_id",
                "id": "engineer",
                "field": "inference_profile_id",
                "target_capture": "profiles",
                "target_key": "profile_id",
                "expect": [
                  {
                    "field": "reasoning_effort",
                    "equals": "high"
                  }
                ]
              },
              {
                "capture": "behaviors",
                "key": "behavior_id",
                "id": "engineer",
                "field": "inference_profile_id",
                "target_capture": "profiles",
                "target_key": "profile_id",
                "expect": [
                  {
                    "field": "max_turns",
                    "equals": 40
                  },
                  {
                    "field": "max_total_tokens",
                    "equals": 300000
                  }
                ],
                "via": [
                  {
                    "field": "execution_id",
                    "target_capture": "executions",
                    "target_key": "execution_id"
                  }
                ]
              },
              {
                "capture": "behaviors",
                "key": "behavior_id",
                "id": "engineer",
                "field": "inference_profile_id",
                "target_capture": "profiles",
                "target_key": "profile_id",
                "expect": [],
                "via": [
                  {
                    "field": "backend_id",
                    "target_capture": "backends",
                    "target_key": "backend_id"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "backends",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
