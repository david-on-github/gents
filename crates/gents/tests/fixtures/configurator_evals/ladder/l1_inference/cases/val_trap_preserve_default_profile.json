{
  "case_id": "val-trap-preserve-default-profile",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "For my long research sessions I need stronger limits: set up an execution exec-deep with max_turns 60, max_total_tokens 400000, and deadline_duration_secs 1800, and a profile profile-deep on my existing backend pointing at exec-deep, and make those limits actually apply when I run engineer. One important constraint: my default profile must stay exactly as it is \u2014 don't touch it or its settings.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "new_profile",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "new_exec_limits",
            "expect": [
              {
                "field": "max_turns",
                "equals": 60
              },
              {
                "field": "max_total_tokens",
                "equals": 400000
              },
              {
                "field": "deadline_duration_secs",
                "equals": 1800
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "new_profile",
          "collection": "InferenceProfile",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "profile_id": {
              "_eq": "profile-deep"
            },
            "execution_id": {
              "_eq": "exec-deep"
            }
          },
          "fields": [
            "profile_id",
            "execution_id",
            "backend_id"
          ]
        },
        {
          "kind": "documents",
          "name": "new_exec_limits",
          "collection": "InferenceExecution",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "execution_id": {
              "_eq": "exec-deep"
            }
          },
          "fields": [
            "execution_id",
            "max_turns",
            "max_total_tokens",
            "deadline_duration_secs"
          ]
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Report what you configured; change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "profiles_total_two",
            "min": 2,
            "max": 2
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "behavior_bound",
            "expect": [
              {
                "field": "inference_profile_id",
                "equals": "profile-deep"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "profiles_total_two",
          "collection": "InferenceProfile",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "profile_id",
            "execution_id"
          ]
        },
        {
          "kind": "documents",
          "name": "behavior_bound",
          "collection": "AgentBehavior",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_eq": "engineer"
            }
          },
          "fields": [
            "behavior_id",
            "inference_profile_id"
          ]
        }
      ]
    },
    {
      "stage_id": "confirm",
      "prompt": "Confirm the default profile is untouched and the limits are in force; change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "exec_deep_unique",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "limited_requests",
            "expect": [
              {
                "field": "request_id",
                "matches": ".+"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "exec_deep_unique",
          "collection": "InferenceProfile",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "execution_id": {
              "_eq": "exec-deep"
            }
          },
          "fields": [
            "profile_id",
            "execution_id"
          ]
        },
        {
          "kind": "documents",
          "name": "limited_requests",
          "collection": "AgentRequest",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_eq": "engineer"
            },
            "max_total_tokens": {
              "_eq": 400000
            }
          },
          "fields": [
            "request_id",
            "behavior_id",
            "max_total_tokens"
          ]
        }
      ]
    }
  ]
}
