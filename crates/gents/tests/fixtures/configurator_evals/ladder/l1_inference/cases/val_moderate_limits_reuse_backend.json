{
  "case_id": "val-moderate-limits-reuse-backend",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "discover",
      "prompt": "Our longer work sessions keep stopping early. Look at the limits we actually have and explain what I could raise. Tell me which model we are using. Please do not change anything yet.",
      "deadline_secs": 600,
      "capture": [
        {
          "kind": "documents",
          "name": "behaviors",
          "collection": "AgentBehavior",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "behavior_id",
            "display_name",
            "context_id",
            "inference_profile_id"
          ]
        },
        {
          "kind": "documents",
          "name": "profiles",
          "collection": "InferenceProfile",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "profile_id",
            "display_name",
            "backend_id",
            "execution_id",
            "model_name",
            "reasoning_effort"
          ]
        },
        {
          "kind": "documents",
          "name": "executions",
          "collection": "InferenceExecution",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "execution_id",
            "max_turns",
            "max_total_tokens",
            "deadline_duration_secs",
            "stream_batch_ms",
            "stream_liveness_timeout_secs",
            "provider_idle_timeout_secs"
          ]
        },
        {
          "kind": "documents",
          "name": "backends",
          "collection": "InferenceBackend",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "backend_id",
            "endpoint",
            "enabled"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ],
            "allowed_argv": {
              "config": [
                [
                  "help"
                ],
                [
                  "get"
                ],
                [
                  "behavior",
                  "get"
                ],
                [
                  "behavior",
                  "list"
                ],
                [
                  "profile",
                  "get"
                ],
                [
                  "profile",
                  "list"
                ],
                [
                  "execution",
                  "get"
                ],
                [
                  "execution",
                  "list"
                ],
                [
                  "backend",
                  "get"
                ],
                [
                  "backend",
                  "list"
                ],
                [
                  "tools",
                  "get"
                ],
                [
                  "tools",
                  "list"
                ]
              ]
            }
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "behaviors",
                "key": "behavior_id",
                "id": "engineer",
                "field": "inference_profile_id",
                "target_capture": "profiles",
                "target_key": "profile_id",
                "expect": [],
                "reported_fields": [
                  "model_name"
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)(limit|budget|allowance)"
              },
              {
                "matches": "(?i)(suggest|recommend|could|would|propos|can)"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "configure",
      "prompt": "Yes, set your limits to 30 turns, 250,000 total tokens, and 15 minutes per request. Keep using the same model and connection; update the current settings rather than making another copy.",
      "deadline_secs": 600,
      "capture": [
        {
          "kind": "documents",
          "name": "behaviors",
          "collection": "AgentBehavior",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "behavior_id",
            "display_name",
            "context_id",
            "inference_profile_id"
          ]
        },
        {
          "kind": "documents",
          "name": "profiles",
          "collection": "InferenceProfile",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "profile_id",
            "display_name",
            "backend_id",
            "execution_id",
            "model_name",
            "reasoning_effort"
          ]
        },
        {
          "kind": "documents",
          "name": "executions",
          "collection": "InferenceExecution",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "execution_id",
            "max_turns",
            "max_total_tokens",
            "deadline_duration_secs",
            "stream_batch_ms",
            "stream_liveness_timeout_secs",
            "provider_idle_timeout_secs"
          ]
        },
        {
          "kind": "documents",
          "name": "backends",
          "collection": "InferenceBackend",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "backend_id",
            "endpoint",
            "enabled"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "behaviors",
                "key": "behavior_id",
                "id": "engineer",
                "field": "inference_profile_id",
                "target_capture": "profiles",
                "target_key": "profile_id",
                "expect": []
              },
              {
                "capture": "behaviors",
                "key": "behavior_id",
                "id": "engineer",
                "field": "inference_profile_id",
                "target_capture": "profiles",
                "target_key": "profile_id",
                "expect": [
                  {
                    "field": "max_turns",
                    "equals": 30
                  },
                  {
                    "field": "max_total_tokens",
                    "equals": 250000
                  },
                  {
                    "field": "deadline_duration_secs",
                    "equals": 900
                  }
                ],
                "via": [
                  {
                    "field": "execution_id",
                    "target_capture": "executions",
                    "target_key": "execution_id"
                  }
                ]
              },
              {
                "capture": "behaviors",
                "key": "behavior_id",
                "id": "engineer",
                "field": "inference_profile_id",
                "target_capture": "profiles",
                "target_key": "profile_id",
                "expect": [],
                "via": [
                  {
                    "field": "backend_id",
                    "target_capture": "backends",
                    "target_key": "backend_id"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "backends",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
