{
  "case_id": "val-moderate-limits-reuse-backend",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "I need real limits on my inference setup. Create an execution exec-work with max_turns 30, max_total_tokens 250000, and deadline_duration_secs 900. Create a profile profile-work on my existing backend \u2014 reuse it, don't create a new one \u2014 pointing at exec-work, and bind engineer to profile-work.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "profile_bound",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "exec_limits",
            "expect": [
              {
                "field": "max_turns",
                "equals": 30
              },
              {
                "field": "max_total_tokens",
                "equals": 250000
              },
              {
                "field": "deadline_duration_secs",
                "equals": 900
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "profile_bound",
          "collection": "InferenceProfile",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "profile_id": {
              "_eq": "profile-work"
            },
            "execution_id": {
              "_eq": "exec-work"
            }
          },
          "fields": [
            "profile_id",
            "execution_id",
            "backend_id"
          ]
        },
        {
          "kind": "documents",
          "name": "exec_limits",
          "collection": "InferenceExecution",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "execution_id": {
              "_eq": "exec-work"
            }
          },
          "fields": [
            "execution_id",
            "max_turns",
            "max_total_tokens",
            "deadline_duration_secs"
          ]
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Report what you configured; change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "backends_unchanged",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "behavior_bound",
            "expect": [
              {
                "field": "inference_profile_id",
                "equals": "profile-work"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "backends_unchanged",
          "collection": "InferenceBackend",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "backend_id",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "behavior_bound",
          "collection": "AgentBehavior",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_eq": "engineer"
            }
          },
          "fields": [
            "behavior_id",
            "inference_profile_id"
          ]
        }
      ]
    },
    {
      "stage_id": "confirm",
      "prompt": "Confirm the limits are in force; change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "limited_requests",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "request_effect",
            "expect": [
              {
                "field": "backend_id",
                "matches": ".+"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "limited_requests",
          "collection": "AgentRequest",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_eq": "engineer"
            },
            "max_total_tokens": {
              "_eq": 250000
            }
          },
          "fields": [
            "request_id",
            "behavior_id",
            "max_total_tokens",
            "backend_id"
          ]
        },
        {
          "kind": "documents",
          "name": "request_effect",
          "collection": "AgentRequest",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_eq": "engineer"
            },
            "max_total_tokens": {
              "_eq": 250000
            }
          },
          "fields": [
            "request_id",
            "backend_id",
            "lifecycle_state"
          ]
        }
      ]
    }
  ]
}
