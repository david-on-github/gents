{
  "case_id": "train-basic-exec-profile-bind",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Set up my inference configuration: create an execution exec-basic with max_turns 20, max_total_tokens 150000, and deadline_duration_secs 600. Then create a profile profile-basic that reuses my existing backend and points at exec-basic, and bind the engineer behavior to profile-basic.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "profile_bound",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "exec_limits",
            "expect": [
              {
                "field": "max_turns",
                "equals": 20
              },
              {
                "field": "max_total_tokens",
                "equals": 150000
              },
              {
                "field": "deadline_duration_secs",
                "equals": 600
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "profile_bound",
          "collection": "InferenceProfile",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "profile_id": {
              "_eq": "profile-basic"
            },
            "execution_id": {
              "_eq": "exec-basic"
            }
          },
          "fields": [
            "profile_id",
            "execution_id",
            "backend_id"
          ]
        },
        {
          "kind": "documents",
          "name": "exec_limits",
          "collection": "InferenceExecution",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "execution_id": {
              "_eq": "exec-basic"
            }
          },
          "fields": [
            "execution_id",
            "max_turns",
            "max_total_tokens",
            "deadline_duration_secs"
          ]
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Report what you configured; change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "limited_requests",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "behavior_bound",
            "expect": [
              {
                "field": "inference_profile_id",
                "equals": "profile-basic"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "limited_requests",
          "collection": "AgentRequest",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_eq": "engineer"
            },
            "max_total_tokens": {
              "_eq": 150000
            }
          },
          "fields": [
            "request_id",
            "behavior_id",
            "max_total_tokens",
            "backend_id"
          ]
        },
        {
          "kind": "documents",
          "name": "behavior_bound",
          "collection": "AgentBehavior",
          "filter": {
            "agent_did": {
              "_eq": "$trial"
            },
            "behavior_id": {
              "_eq": "engineer"
            }
          },
          "fields": [
            "behavior_id",
            "inference_profile_id"
          ]
        }
      ]
    }
  ]
}
